[Unit]
Description=3TSahur driver station (MotionModule controller)
After=network.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=-/etc/stem-research-academy/config.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash @APP_DIR@/installer/start-dashboard.sh @APP_DIR@
Restart=always
RestartSec=2
TimeoutStopSec=5
# Hard ceiling for the driver station, camera stream, and control service.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
